---
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo/logo-fajar-sunnah.png';
import { mainNavItems } from '../../data/navigation';
import { getRegistrationUrl, school } from '../../data/school';

const regUrl = getRegistrationUrl();
---

<header class="site-header" id="site-header">
  <div class="site-header__container">
    <!-- Brand / Identitas Sekolah -->
    <a href="#beranda" class="site-header__brand" aria-label={`${school.name} - Beranda`}>
      <div class="site-header__logo-wrap">
        <Image
          src={logoImg}
          alt={`Logo ${school.name}`}
          width={40}
          height={40}
          class="site-header__logo"
          loading="eager"
        />
      </div>
      <div class="site-header__titles">
        <span class="site-header__name">{school.name}</span>
        <span class="site-header__loc">Lembang, Jawa Barat</span>
      </div>
    </a>

    <!-- Menu Navigasi Desktop (Hanya muncul di layar lebar >= 1080px) -->
    <nav class="site-header__nav" aria-label="Navigasi Utama">
      <ul class="site-header__menu">
        {mainNavItems.map((item) => (
          <li>
            <a href={item.href} class="site-header__link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Area Tombol Aksi -->
    <div class="site-header__actions">
      <!-- Tombol CTA Desktop (Hanya aktif di desktop >= 1080px) -->
      <a href={regUrl} target="_blank" rel="noopener noreferrer" class="site-header__cta-desktop">
        Daftar SPMB
      </a>

      <!-- Tombol CTA Mobile (Hanya aktif di mobile < 1080px) -->
      <a href={regUrl} target="_blank" rel="noopener noreferrer" class="site-header__cta-mobile" aria-label="Daftar SPMB Online">
        Daftar
      </a>

      <!-- Tombol Hamburger Mobile (Hanya aktif di mobile < 1080px) -->
      <button
        type="button"
        class="site-header__toggle"
        id="mobile-menu-toggle"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* Sticky Header Wrapper */
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 2px 6px rgba(16, 24, 40, 0.04);
  }

  /* Baris Utama Header: Flexbox Satu Baris Mutlak */
  .site-header__container {
    width: 100%;
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    height: 64px;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: nowrap !important;
    gap: 1rem;
    box-sizing: border-box;
  }

  @media (min-width: 640px) {
    .site-header__container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  @media (min-width: 1080px) {
    .site-header__container {
      height: 72px;
      gap: 1.5rem;
    }
  }

  /* Logo & Brand */
  .site-header__brand {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.65rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__logo-wrap {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  @media (min-width: 1080px) {
    .site-header__logo-wrap {
      width: 42px;
      height: 42px;
    }
  }

  .site-header__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-header__titles {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .site-header__name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-navy-950);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .site-header__name {
      font-size: 1.05rem;
    }
  }

  .site-header__loc {
    font-size: 0.72rem;
    color: var(--color-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 380px) {
    .site-header__loc {
      display: none;
    }
  }

  /* -------------------------------------------
     Desktop Navigation: Default HIDDEN on mobile
     ------------------------------------------- */
  .site-header__nav {
    display: none !important;
  }

  .site-header__menu {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }

  .site-header__link {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .site-header__link:hover {
    color: var(--color-navy-800);
    background-color: var(--color-bg-subtle);
  }

  /* -------------------------------------------
     Actions Area
     ------------------------------------------- */
  .site-header__actions {
    display: flex !important;
    align-items: center !important;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  /* Desktop CTA: Default HIDDEN on mobile */
  .site-header__cta-desktop {
    display: none !important;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.25;
    background-color: var(--color-navy-950);
    color: #ffffff;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--color-navy-950);
    transition: background-color 0.15s ease;
  }

  .site-header__cta-desktop:hover {
    background-color: var(--color-navy-800);
  }

  /* Mobile CTA: Visible on mobile */
  .site-header__cta-mobile {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.85rem;
    font-size: var(--text-xs);
    font-weight: 700;
    background-color: var(--color-navy-950);
    color: #ffffff;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--color-navy-950);
    transition: background-color 0.15s ease;
  }

  .site-header__cta-mobile:hover {
    background-color: var(--color-navy-800);
  }

  /* Mobile Toggle: Visible on mobile */
  .site-header__toggle {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-navy-950);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: background-color 0.15s ease;
  }

  .site-header__toggle:hover {
    background-color: #e4e7ec;
  }

  /* -------------------------------------------
     BREAKPOINT: Desktop (>= 1080px)
     Aktifkan Navigasi & Tombol Desktop,
     Sembunyikan Tombol & Hamburger Mobile
     ------------------------------------------- */
  @media (min-width: 1080px) {
    .site-header__nav {
      display: block !important;
    }

    .site-header__cta-desktop {
      display: inline-flex !important;
    }

    .site-header__cta-mobile {
      display: none !important;
    }

    .site-header__toggle {
      display: none !important;
    }
  }
</style>
