---
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo/logo-fajar-sunnah.png';
import { mainNavItems } from '../../data/navigation';
import { getRegistrationUrl, school } from '../../data/school';
import Button from '../ui/Button.astro';

const regUrl = getRegistrationUrl();
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <!-- Brand / Logo -->
    <a href="#beranda" class="site-header__brand" aria-label={`${school.name} - Kembali ke beranda`}>
      <div class="site-header__logo-wrap">
        <Image
          src={logoImg}
          alt={`Logo ${school.name}`}
          width={40}
          height={40}
          class="site-header__logo"
          loading="eager"
        />
      </div>
      <div class="site-header__titles">
        <span class="site-header__name">{school.name}</span>
        <span class="site-header__loc">Lembang, Jawa Barat</span>
      </div>
    </a>

    <!-- Desktop Navigation (Visible on >= 1080px to guarantee single-line layout) -->
    <nav class="site-header__nav" aria-label="Navigasi Utama">
      <ul class="site-header__menu">
        {mainNavItems.map((item) => (
          <li>
            <a href={item.href} class="site-header__link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Desktop CTA + Mobile Quick Button & Hamburger) -->
    <div class="site-header__actions">
      <!-- Desktop CTA Button -->
      <Button href={regUrl} variant="primary" class="site-header__cta-desktop">
        Daftar PPDB
      </Button>

      <!-- Mobile Quick Register Button (Compact 1-tap conversion) -->
      <a href={regUrl} class="site-header__cta-mobile" aria-label="Daftar PPDB Online">
        Daftar
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="site-header__toggle"
        id="mobile-menu-toggle"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="site-header__toggle-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 1px 4px rgba(16, 24, 40, 0.04);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 66px;
    gap: 1rem;
  }

  @media (min-width: 1080px) {
    .site-header__inner {
      height: 74px;
      gap: 1.75rem;
    }
  }

  /* Brand Styling */
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__logo-wrap {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  @media (min-width: 1080px) {
    .site-header__logo-wrap {
      width: 42px;
      height: 42px;
    }
  }

  .site-header__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-header__titles {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .site-header__name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-navy-950);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .site-header__name {
      font-size: 1.05rem;
    }
  }

  .site-header__loc {
    font-size: 0.72rem;
    color: var(--color-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 380px) {
    .site-header__loc {
      display: none;
    }
  }

  /* Desktop Navigation */
  .site-header__nav {
    display: none;
  }

  .site-header__menu {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .site-header__link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .site-header__link:hover {
    color: var(--color-navy-800);
    background-color: var(--color-bg-subtle);
  }

  /* Actions Area */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .site-header__cta-desktop {
    display: none;
  }

  .site-header__cta-mobile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.85rem;
    font-size: var(--text-xs);
    font-weight: 700;
    background-color: var(--color-navy-950);
    color: #ffffff;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__cta-mobile:hover {
    background-color: var(--color-navy-800);
  }

  /* Toggle button */
  .site-header__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-navy-950);
    cursor: pointer;
    padding: 0;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .site-header__toggle:hover {
    background-color: #e4e7ec;
    border-color: var(--color-muted);
  }

  /* Responsive layout: Desktop >= 1080px */
  @media (min-width: 1080px) {
    .site-header__nav {
      display: block;
    }

    .site-header__cta-desktop {
      display: inline-flex;
    }

    .site-header__cta-mobile {
      display: none;
    }

    .site-header__toggle {
      display: none;
    }
  }
</style>
