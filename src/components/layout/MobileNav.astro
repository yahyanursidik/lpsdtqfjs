---
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo/logo-fajar-sunnah.png';
import { mainNavItems } from '../../data/navigation';
import { getRegistrationUrl, getWhatsAppUrl, school } from '../../data/school';

const regUrl = getRegistrationUrl();
const waUrl = getWhatsAppUrl();
---

<div
  id="mobile-nav"
  class="mobile-nav"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menu Navigasi Mobile"
>
  <!-- Backdrop -->
  <div class="mobile-nav__backdrop" id="mobile-nav-backdrop"></div>

  <!-- Slide-out Drawer Panel -->
  <div class="mobile-nav__drawer">
    <!-- Drawer Top Header -->
    <div class="mobile-nav__header">
      <div class="mobile-nav__brand">
        <Image
          src={logoImg}
          alt={`Logo ${school.name}`}
          width={36}
          height={36}
          class="mobile-nav__logo"
        />
        <div class="mobile-nav__titles">
          <span class="mobile-nav__title">{school.name}</span>
          <span class="mobile-nav__sub">PPDB {school.academicYear}</span>
        </div>
      </div>

      <button
        type="button"
        id="mobile-nav-close"
        class="mobile-nav__close"
        aria-label="Tutup menu navigasi"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Navigation List -->
    <nav class="mobile-nav__nav" aria-label="Menu Navigasi Layar Kecil">
      <ul class="mobile-nav__menu">
        {mainNavItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav__link js-mobile-link">
              <span>{item.label}</span>
              <svg class="mobile-nav__chevron" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Drawer Action Buttons -->
    <div class="mobile-nav__actions">
      <a href={regUrl} target="_blank" rel="noopener noreferrer" class="mobile-nav__btn mobile-nav__btn--primary js-mobile-link">
        Daftar PPDB Sekarang
      </a>
      <a href={waUrl} target="_blank" rel="noopener noreferrer" class="mobile-nav__btn mobile-nav__btn--whatsapp">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.2 3.7.59.25 1.05.4 1.41.51.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
        </svg>
        <span>Tanya via WhatsApp</span>
      </a>

      <!-- Quick Contact Info -->
      <div class="mobile-nav__meta">
        <p><strong>Kampus:</strong> BTN Pusdikajen Lembang</p>
        <p><strong>Hotline:</strong> {school.contact.whatsappDisplay}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 1200;
    visibility: hidden;
    opacity: 0;
    transition: visibility 0.25s ease, opacity 0.25s ease;
  }

  .mobile-nav[aria-hidden="false"] {
    visibility: visible;
    opacity: 1;
  }

  .mobile-nav__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(7, 22, 50, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .mobile-nav__drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 86%;
    max-width: 360px;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.25rem 2rem 1.25rem;
    box-shadow: -6px 0 28px rgba(7, 22, 50, 0.2);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-nav[aria-hidden="false"] .mobile-nav__drawer {
    transform: translateX(0);
  }

  .mobile-nav__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .mobile-nav__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-nav__logo {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    object-fit: contain;
  }

  .mobile-nav__titles {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .mobile-nav__title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-navy-950);
  }

  .mobile-nav__sub {
    font-size: 0.72rem;
    color: var(--color-navy-800);
    font-weight: 600;
  }

  .mobile-nav__close {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-navy-950);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .mobile-nav__close:hover {
    background-color: #e4e7ec;
  }

  .mobile-nav__nav {
    margin-top: 1rem;
    flex: 1;
  }

  .mobile-nav__menu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0;
    margin: 0;
  }

  .mobile-nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 46px;
    padding: 0.75rem 0.85rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-ink);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .mobile-nav__link:hover,
  .mobile-nav__link:active {
    background-color: var(--color-bg-subtle);
    color: var(--color-navy-950);
  }

  .mobile-nav__chevron {
    color: var(--color-muted);
  }

  .mobile-nav__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .mobile-nav__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: var(--radius-sm);
    text-decoration: none;
    text-align: center;
    border: 1px solid transparent;
    transition: background-color 0.15s ease;
  }

  .mobile-nav__btn--primary {
    background-color: var(--color-navy-950);
    color: #ffffff;
  }

  .mobile-nav__btn--primary:hover {
    background-color: var(--color-navy-800);
  }

  .mobile-nav__btn--whatsapp {
    background-color: transparent;
    color: var(--color-navy-950);
    border-color: var(--color-border);
  }

  .mobile-nav__btn--whatsapp:hover {
    background-color: var(--color-bg-subtle);
    border-color: var(--color-navy-950);
  }

  .mobile-nav__meta {
    font-size: 0.75rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin-top: 0.5rem;
  }
</style>

<script>
  function setupMobileNav() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const nav = document.getElementById('mobile-nav');
    const closeBtn = document.getElementById('mobile-nav-close');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const navLinks = document.querySelectorAll('.js-mobile-link');

    if (!toggleBtn || !nav) return;

    function openNav() {
      nav?.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeNav() {
      nav?.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggleBtn?.focus();
    }

    toggleBtn.addEventListener('click', openNav);
    closeBtn?.addEventListener('click', closeNav);
    backdrop?.addEventListener('click', closeNav);

    navLinks.forEach((link) => {
      link.addEventListener('click', closeNav);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.getAttribute('aria-hidden') === 'false') {
        closeNav();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupMobileNav);
  setupMobileNav();
</script>
