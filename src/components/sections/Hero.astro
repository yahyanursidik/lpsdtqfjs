---
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo/logo-fajar-sunnah.png';
import { getRegistrationUrl, getWhatsAppUrl, school } from '../../data/school';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

const regUrl = getRegistrationUrl();
const waUrl = getWhatsAppUrl();

const proofPoints = [
  { value: '3–6 Juz', label: 'Target Tahfidz Mutqin' },
  { value: '1 : 7', label: 'Rasio Guru & Siswa Halaqah' },
  { value: 'Personalized', label: 'Pendekatan Belajar Terarah' },
];
---

<section class="hero" id="beranda" aria-labelledby="hero-title">
  <Container class="hero__container">
    <div class="hero__content">
      <!-- Plain textual context label, NO pill badge / status dot per anti-slop rules -->
      <span class="hero__eyebrow">PPDB SDTQ FAJAR SUNNAH {school.academicYear}</span>

      <h1 id="hero-title" class="hero__title">
        {school.tagline}
      </h1>

      <p class="hero__lead">
        {school.subtagline}
      </p>

      <div class="hero__actions">
        <Button href={regUrl} variant="primary" class="hero__btn-main">
          Daftar PPDB Sekarang
        </Button>
        <Button href={waUrl} variant="outline" external class="hero__btn-sub">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.2 3.7.59.25 1.05.4 1.41.51.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
          </svg>
          Tanya via WhatsApp
        </Button>
      </div>

      <!-- Proof points (limited to 3 max per anti-slop rules) -->
      <div class="hero__proof-points">
        {proofPoints.map((item) => (
          <div class="hero__proof-item">
            <span class="hero__proof-val">{item.value}</span>
            <span class="hero__proof-lbl">{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Editorial Visual Feature Card -->
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__card">
        <div class="hero__card-top">
          <Image
            src={logoImg}
            alt=""
            width={120}
            height={120}
            class="hero__card-logo"
            loading="eager"
          />
          <div class="hero__card-badge">
            <span class="hero__card-location">Kayuambon, Lembang</span>
            <span class="hero__card-status">Penerimaan Siswa Baru & Pindahan</span>
          </div>
        </div>
        <div class="hero__card-body">
          <h2 class="hero__card-heading">{school.fullName}</h2>
          <p class="hero__card-text">
            Membentuk generasi pembelajar yang berakhlak mulia, hafal Al-Qur'an dengan bacaan tartil, dan berprestasi dalam kurikulum akademik nasional.
          </p>
          <div class="hero__card-pills">
            <span>Kurikulum Terpadu</span>
            <span>Halaqah 1:7</span>
            <span>Berijazah Resmi</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: linear-gradient(180deg, #ffffff 0%, var(--color-bg-soft) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero__container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Anti-slop: plain uppercase text, no decorative pill/badge */
  .hero__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-navy-800);
    margin-bottom: 0.85rem;
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-navy-950);
    margin-bottom: 1.25rem;
  }

  .hero__lead {
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-ink-light);
    margin-bottom: 2rem;
    max-width: 620px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 2.75rem;
    width: 100%;
  }

  @media (min-width: 480px) {
    .hero__actions {
      width: auto;
    }
  }

  .hero__proof-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    width: 100%;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .hero__proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero__proof-val {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-navy-950);
    letter-spacing: -0.02em;
  }

  .hero__proof-lbl {
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: 1.4;
  }

  /* Editorial Card */
  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__card {
    width: 100%;
    max-width: 460px;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-soft);
    position: relative;
  }

  .hero__card-top {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .hero__card-logo {
    width: 80px;
    height: 80px;
    object-fit: contain;
    border-radius: 50%;
    background-color: var(--color-bg-soft);
    padding: 4px;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .hero__card-badge {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero__card-location {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-navy-800);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero__card-status {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__card-heading {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-navy-950);
    margin-bottom: 0.65rem;
  }

  .hero__card-text {
    font-size: var(--text-sm);
    color: var(--color-ink-light);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .hero__card-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero__card-pills span {
    font-size: var(--text-xs);
    font-weight: 600;
    background-color: var(--color-bg-subtle);
    color: var(--color-navy-950);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
</style>
