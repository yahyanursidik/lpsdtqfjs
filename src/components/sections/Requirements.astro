---
import { admissionRequirements } from '../../data/admissions';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="section section--soft" id="syarat" aria-labelledby="requirements-title">
  <Container>
    <div class="requirements-layout">
      <div class="requirements-intro">
        <SectionHeading
          eyebrow="Kelengkapan Berkas"
          title="Persyaratan Pendaftaran SPMB"
          description="Dokumen administratif yang perlu disiapkan oleh orang tua/wali murid sebelum pelaksanaan observasi dan daftar ulang."
          align="left"
        />

        <div class="requirements-box">
          <h3 class="requirements-box__title">Penerimaan Murid Pindahan</h3>
          <p class="requirements-box__text">
            Bagi murid pindahan / mutasi, selain berkas identitas di samping, wajib menyertakan surat mutasi dari sekolah asal serta fotokopi buku rapor semester terakhir.
          </p>
        </div>
      </div>

      <div class="requirements-list-wrap">
        <ol class="requirements-list">
          {admissionRequirements.map((req, idx) => (
            <li class="requirements-item">
              <span class="requirements-item__num">{idx + 1}</span>
              <span class="requirements-item__text">{req}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Container>
</section>

<style>
  .requirements-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 992px) {
    .requirements-layout {
      grid-template-columns: 1fr 1.2fr;
      gap: 4rem;
    }
  }

  .requirements-box {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .requirements-box__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-navy-950);
    margin-bottom: 0.5rem;
  }

  .requirements-box__text {
    font-size: var(--text-sm);
    color: var(--color-ink-light);
    line-height: 1.6;
  }

  .requirements-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0;
  }

  .requirements-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
  }

  .requirements-item__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-navy-950);
    font-size: var(--text-xs);
    font-weight: 700;
    flex-shrink: 0;
  }

  .requirements-item__text {
    font-size: var(--text-sm);
    color: var(--color-ink);
    line-height: 1.5;
  }
</style>
