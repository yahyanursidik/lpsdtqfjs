---
import { alumniTestimonials } from '../../data/testimonials';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="section" id="testimoni-alumni" aria-label="Testimoni alumni SDTQ Fajar Sunnah">
  <Container>
    <SectionHeading
      eyebrow="Cerita Alumni"
      title="Testimoni dari Alumni SDTQ Fajar Sunnah"
      description="Simak pengalaman para alumni setelah menempuh pendidikan di SDTQ Fajar Sunnah."
      align="center"
    />

    <div class="alumni-testimonials__grid">
      {alumniTestimonials.map((video, index) => (
        <figure class="alumni-testimonial">
          <video
            class="alumni-testimonial__player"
            controls
            preload="metadata"
            playsinline
            aria-label={`Video testimoni alumni SDTQ Fajar Sunnah ${index + 1}`}
          >
            <source src={video.src} type="video/mp4" />
            Browser Anda belum mendukung pemutaran video.
          </video>
          <figcaption>Video testimoni alumni SDTQ Fajar Sunnah</figcaption>
        </figure>
      ))}
    </div>
  </Container>
</section>

<style>
  .alumni-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .alumni-testimonials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .alumni-testimonial {
    width: min(100%, 22rem);
    margin: 0 auto;
  }

  .alumni-testimonial__player {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    background-color: var(--color-navy-950);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .alumni-testimonial figcaption {
    margin-top: 0.8rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    text-align: center;
  }
</style>
