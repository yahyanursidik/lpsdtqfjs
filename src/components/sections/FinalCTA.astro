---
import { getRegistrationUrl, getWhatsAppUrl, school } from '../../data/school';
import Button from '../ui/Button.astro';

const regUrl = getRegistrationUrl();
const waUrl = getWhatsAppUrl();
---

<section class="final-cta" aria-labelledby="cta-title">
  <div class="container-narrow final-cta__container">
    <span class="final-cta__eyebrow">Langkah Pendaftaran PPDB</span>
    <h2 id="cta-title" class="final-cta__title">
      Siap Mengenal Fajar Sunnah Lebih Dekat?
    </h2>
    <p class="final-cta__lead">
      Mari bersama-sama membimbing ananda menjadi generasi penghafal Al-Qur'an yang bertauhid lurus, beradab mulia, dan berprestasi untuk masa depan.
    </p>

    <div class="final-cta__actions">
      <Button href={regUrl} variant="yellow" external class="final-cta__btn-primary">
        Daftar PPDB {school.academicYear}
      </Button>
      <Button href={waUrl} variant="outline" external class="final-cta__btn-secondary">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.2 3.7.59.25 1.05.4 1.41.51.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
        </svg>
        Tanya via WhatsApp
      </Button>
    </div>

    <div class="final-cta__meta">
      <span>Lokasi: BTN Pusdikajen Lembang</span>
      <span>•</span>
      <span>WhatsApp: {school.contact.whatsappDisplay}</span>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background-color: var(--color-navy-950);
    color: #ffffff;
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    text-align: center;
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .final-cta__container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final-cta__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-yellow-400);
    margin-bottom: 0.85rem;
  }

  .final-cta__title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .final-cta__lead {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.65;
    max-width: 600px;
    margin-bottom: 2.25rem;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.25rem;
    width: 100%;
  }

  .final-cta__btn-secondary {
    background-color: transparent !important;
    border-color: rgba(255, 255, 255, 0.35) !important;
    color: #ffffff !important;
  }

  .final-cta__btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1) !important;
    border-color: #ffffff !important;
  }

  .final-cta__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
  }
</style>
