---
import { fees, formatRupiah } from '../../data/fees';
import { getRegistrationUrl } from '../../data/school';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const regUrl = getRegistrationUrl();
---

<section class="section" id="biaya" aria-labelledby="fees-title">
  <Container>
    <SectionHeading
      eyebrow="Transparansi Finansial"
      title="Rincian Investasi Pendidikan"
      description="Seluruh rincian pembiayaan disajikan secara terbuka tanpa biaya tersembunyi. Biaya pembangunan berlaku untuk 6 tahun penuh dan dapat dicicil fleksibel."
      align="center"
    />

    <div class="fees-grid">
      <!-- Card 1: Pendaftaran & Promo -->
      <div class="fee-card fee-card--featured">
        <div class="fee-card__header">
          <span class="fee-card__label">{fees.registration.label}</span>
          <div class="fee-card__price">{formatRupiah(fees.registration.amount)}</div>
          <div class="fee-card__promo">
            <strong>Promo:</strong> {fees.registration.promo}
          </div>
        </div>
        <p class="fee-card__desc">{fees.registration.note}</p>
        <div class="fee-card__footer">
          <Button href={regUrl} variant="primary" external class="fee-card__btn">
            Ambil Kuota Promo
          </Button>
        </div>
      </div>

      <!-- Card 2: Biaya Sewa Gedung & Pengembangan (6 Tahun) -->
      <div class="fee-card">
        <div class="fee-card__header">
          <span class="fee-card__label">{fees.buildingAndDevelopment.label}</span>
          <div class="fee-card__price">{formatRupiah(fees.buildingAndDevelopment.amount)}</div>
          <span class="fee-card__period">{fees.buildingAndDevelopment.period}</span>
        </div>
        <div class="fee-card__installment-badge">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>{fees.buildingAndDevelopment.installmentNote}</span>
        </div>
        <p class="fee-card__desc">
          Mencakup hak fasilitas belajar, sarana olahraga, perawatan kelas, serta pengembangan media edukasi selama menempuh 6 tahun sekolah dasar.
        </p>
      </div>

      <!-- Card 3: Daftar Ulang & Rincian Komponen -->
      <div class="fee-card">
        <div class="fee-card__header">
          <span class="fee-card__label">{fees.reRegistration.label}</span>
          <div class="fee-card__price">{formatRupiah(fees.reRegistration.total)}</div>
          <span class="fee-card__period">{fees.reRegistration.note}</span>
        </div>

        <ul class="fee-card__breakdown">
          {fees.reRegistration.breakdown.map((item) => (
            <li class="fee-breakdown-item">
              <span class="fee-breakdown-item__lbl">{item.label}</span>
              <span class="fee-breakdown-item__val">{formatRupiah(item.amount)}</span>
            </li>
          ))}
          <li class="fee-breakdown-item fee-breakdown-item--addon">
            <span class="fee-breakdown-item__lbl">
              {fees.reRegistration.addon.label}
              <small>({fees.reRegistration.addon.note})</small>
            </span>
            <span class="fee-breakdown-item__val">+{formatRupiah(fees.reRegistration.addon.amount)}</span>
          </li>
        </ul>
      </div>
    </div>
  </Container>
</section>

<style>
  .fees-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 768px) {
    .fees-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .fee-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
  }

  .fee-card--featured {
    border-color: var(--color-navy-950);
    position: relative;
    box-shadow: var(--shadow-soft);
  }

  .fee-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .fee-card__label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-navy-800);
  }

  .fee-card__price {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-navy-950);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .fee-card__period {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .fee-card__promo {
    font-size: var(--text-xs);
    background-color: var(--color-yellow-100);
    color: var(--color-navy-950);
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
    line-height: 1.4;
    border: 1px solid var(--color-yellow-400);
  }

  .fee-card__installment-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-navy-800);
    background-color: var(--color-bg-subtle);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    border: 1px solid var(--color-border);
  }

  .fee-card__desc {
    font-size: var(--text-sm);
    color: var(--color-ink-light);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .fee-card__footer {
    margin-top: auto;
  }

  .fee-card__btn {
    width: 100%;
  }

  .fee-card__breakdown {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0;
  }

  .fee-breakdown-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: var(--text-xs);
    color: var(--color-ink);
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--color-border-light);
  }

  .fee-breakdown-item__lbl small {
    display: block;
    color: var(--color-muted);
    font-size: 0.7rem;
  }

  .fee-breakdown-item__val {
    font-weight: 700;
    color: var(--color-navy-950);
    white-space: nowrap;
  }

  .fee-breakdown-item--addon {
    border-bottom: none;
    padding-top: 0.35rem;
    color: var(--color-muted);
  }
</style>
