---
import { faqs } from '../../data/faq';
import { getWhatsAppUrl } from '../../data/school';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const waUrl = getWhatsAppUrl();
---

<section class="section section--soft" id="faq" aria-labelledby="faq-title">
  <Container narrow>
    <SectionHeading
      eyebrow="Tanya Jawab"
      title="Pertanyaan yang Sering Diajukan"
      description="Informasi penting seputar target hafalan, kurikulum, alur penerimaan siswa baru, dan pembiayaan pendidikan di SDTQ Fajar Sunnah."
      align="center"
    />

    <!-- Native Accessible Details/Summary Accordion -->
    <div class="faq-accordion">
      {faqs.map((item, idx) => (
        <details class="faq-item" open={idx === 0}>
          <summary class="faq-item__question">
            <span class="faq-item__title">{item.question}</span>
            <span class="faq-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-item__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Contact support box if parent still has questions -->
    <div class="faq-support">
      <h3 class="faq-support__title">Masih Memiliki Pertanyaan Lain?</h3>
      <p class="faq-support__desc">
        Panitia PPDB SDTQ Fajar Sunnah siap memberikan penjelasan lengkap mengenai program belajar dan observasi ananda.
      </p>
      <Button href={waUrl} variant="outline" external class="faq-support__btn">
        Konsultasi via WhatsApp
      </Button>
    </div>
  </Container>
</section>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .faq-item {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: border-color 0.15s ease;
  }

  .faq-item[open] {
    border-color: var(--color-navy-800);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-navy-950);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question:hover {
    color: var(--color-navy-800);
  }

  .faq-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--color-bg-subtle);
    color: var(--color-navy-950);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    padding: 0 1.5rem 1.25rem 1.5rem;
    font-size: var(--text-sm);
    color: var(--color-ink-light);
    line-height: 1.65;
    border-top: 1px solid var(--color-border-light);
    padding-top: 1rem;
  }

  .faq-support {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.25rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    box-shadow: var(--shadow-card);
  }

  .faq-support__title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-navy-950);
  }

  .faq-support__desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    max-width: 500px;
    margin-bottom: 0.5rem;
  }
</style>
