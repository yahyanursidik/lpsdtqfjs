---
import { admissionWaves } from '../../data/admissions';
import { getRegistrationUrl, school } from '../../data/school';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const regUrl = getRegistrationUrl();
---

<section class="section" id="spmb" aria-labelledby="admissions-title">
  <span id="ppdb" class="sr-only"></span>
  <Container>
    <SectionHeading
      eyebrow={`Sistem Penerimaan Murid Baru (SPMB) ${school.academicYear}`}
      title="Jadwal & Alur Timeline SPMB"
      description="Pendaftaran terbuka untuk calon murid kelas 1 dan murid mutasi/pindahan. Pendaftaran gelombang 1 diprioritaskan untuk pemenuhan kuota utama."
      align="center"
    />

    <div class="admissions-waves">
      {admissionWaves.map((wave, idx) => (
        <div class="wave-card">
          <div class="wave-card__header">
            <div>
              <span class="wave-card__badge">Tahap {idx + 1}</span>
              <h3 class="wave-card__title">{wave.name}</h3>
            </div>
            {wave.note && (
              <span class="wave-card__note">{wave.note}</span>
            )}
          </div>

          <div class="wave-card__dates">
            {wave.dates.map(([event, date]) => (
              <div class="wave-date-row">
                <span class="wave-date-row__event">{event}</span>
                <span class="wave-date-row__line" aria-hidden="true"></span>
                <span class="wave-date-row__date">{date}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="admissions-cta">
      <p class="admissions-cta__text">
        Kuota belajar terbatas untuk menjaga efektivitas rasio halaqah tahfidz 1 : 7 murid.
      </p>
      <Button href={regUrl} variant="primary" external class="admissions-cta__btn">
        Daftar SPMB Sekarang
      </Button>
    </div>
  </Container>
</section>

<style>
  .admissions-waves {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .admissions-waves {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  .wave-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.25rem 2rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .wave-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--color-border-light);
  }

  .wave-card__badge {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-navy-800);
  }

  .wave-card__title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-navy-950);
  }

  .wave-card__note {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-style: italic;
  }

  .wave-card__dates {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .wave-date-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .wave-date-row__event {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .wave-date-row__line {
    flex: 1;
    border-bottom: 1px dashed var(--color-border);
    min-width: 1rem;
  }

  .wave-date-row__date {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-navy-950);
    text-align: right;
    white-space: nowrap;
  }

  .admissions-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .admissions-cta__text {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-weight: 500;
  }
</style>
