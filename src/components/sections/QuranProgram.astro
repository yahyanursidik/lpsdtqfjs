---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const quranFeatures = [
  {
    title: 'Tahsin & Makharijul Huruf',
    desc: 'Sebelum akselerasi hafalan, santri dibimbing membetulkan pelafalan huruf hijaiyah, sifat huruf, dan kaidah tajwid secara tartil.',
  },
  {
    title: 'Personalized Learning Pace',
    desc: 'Kami menyadari kesiapan dan daya ingat setiap anak berbeda. Target harian hafalan disesuaikan tanpa tekanan psikologis yang membebani.',
  },
  {
    title: "Sistem Muroja'ah Berkesinambungan",
    desc: 'Hafalan yang telah disetor diulang secara terstruktur setiap hari (sabqi & manzil) agar melekat kuat dalam ingatan santri hingga lulus.',
  },
  {
    title: 'Halaqah Intensif 1 : 7',
    desc: 'Satu guru halaqah tahfidz mendampingi maksimal 7 santri, sehingga setiap ayat yang dibaca mendapat koreksi langsung secara teliti.',
  },
];
---

<section class="section quran-section" id="tahfidz" aria-labelledby="quran-title">
  <Container>
    <div class="quran-section__layout">
      <!-- Visual Anchor Column (3-6 Juz) -->
      <div class="quran-section__anchor">
        <div class="quran-anchor-card">
          <span class="quran-anchor-card__tag">Target Capaian 6 Tahun</span>
          <div class="quran-anchor-card__number">3–6</div>
          <div class="quran-anchor-card__unit">JUZ AL-QUR'AN</div>
          <p class="quran-anchor-card__sub">
            Target hafalan realistis dan berkualitas mutqin, disempurnakan dengan pemahaman bacaan dan adab penghafal Al-Qur'an.
          </p>
          <div class="quran-anchor-card__meta">
            <div class="quran-anchor-meta-item">
              <span class="quran-anchor-meta-val">Tartil</span>
              <span class="quran-anchor-meta-lbl">Kaidah Tajwid</span>
            </div>
            <div class="quran-anchor-meta-divider"></div>
            <div class="quran-anchor-meta-item">
              <span class="quran-anchor-meta-val">Mutqin</span>
              <span class="quran-anchor-meta-lbl">Kualitas Hafalan</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Explanatory Content Column -->
      <div class="quran-section__details">
        <SectionHeading
          eyebrow="Program Utama"
          title="Metode Tahfidz & Tahsin yang Terarah dan Menggembirakan"
          description="Menghafal Al-Qur'an bukan sekadar mengejar kuantitas ayat, melainkan menanamkan kecintaan mendalam pada firman Allah dengan bacaan yang benar dan adab yang mulia."
          align="left"
        />

        <div class="quran-features-grid">
          {quranFeatures.map((item) => (
            <div class="quran-feature-item">
              <h3 class="quran-feature-item__title">{item.title}</h3>
              <p class="quran-feature-item__desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .quran-section {
    background-color: #ffffff;
  }

  .quran-section__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .quran-section__layout {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4.5rem;
    }
  }

  /* Visual Anchor Card */
  .quran-section__anchor {
    display: flex;
    justify-content: center;
  }

  .quran-anchor-card {
    width: 100%;
    max-width: 420px;
    background-color: var(--color-navy-950);
    color: #ffffff;
    border-radius: var(--radius-md);
    padding: 3rem 2.25rem;
    text-align: center;
    border: 2px solid var(--color-yellow-500);
    box-shadow: var(--shadow-soft);
  }

  .quran-anchor-card__tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-yellow-400);
    margin-bottom: 0.75rem;
  }

  .quran-anchor-card__number {
    font-size: clamp(4rem, 9vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .quran-anchor-card__unit {
    font-size: var(--text-base);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-yellow-400);
    margin-bottom: 1.25rem;
  }

  .quran-anchor-card__sub {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .quran-anchor-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .quran-anchor-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .quran-anchor-meta-val {
    font-size: var(--text-base);
    font-weight: 700;
    color: #ffffff;
  }

  .quran-anchor-meta-lbl {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.65);
  }

  .quran-anchor-meta-divider {
    width: 1px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.18);
  }

  /* Feature Grid */
  .quran-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .quran-features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.75rem;
    }
  }

  .quran-feature-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .quran-feature-item__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-navy-950);
  }

  .quran-feature-item__desc {
    font-size: var(--text-sm);
    color: var(--color-ink-light);
    line-height: 1.55;
  }
</style>
