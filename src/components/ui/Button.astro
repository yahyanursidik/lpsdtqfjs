---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'outline-white' | 'yellow';
  external?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  external = false,
  ariaLabel,
  class: className = '',
} = Astro.props;

const targetAttr = external ? '_blank' : undefined;
const relAttr = external ? 'noopener noreferrer' : undefined;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, className]}
  target={targetAttr}
  rel={relAttr}
  aria-label={ariaLabel}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.35rem;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.25;
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-align: center;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
    white-space: nowrap;
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn--primary {
    background-color: var(--color-navy-950);
    color: #ffffff;
    border-color: var(--color-navy-950);
  }

  .btn--primary:hover {
    background-color: var(--color-navy-800);
    border-color: var(--color-navy-800);
  }

  .btn--secondary {
    background-color: var(--color-border-light);
    color: var(--color-navy-950);
    border-color: var(--color-border);
  }

  .btn--secondary:hover {
    background-color: #e4e7ec;
  }

  .btn--outline {
    background-color: transparent;
    color: var(--color-navy-950);
    border-color: var(--color-border);
  }

  .btn--outline:hover {
    background-color: var(--color-bg-soft);
    border-color: var(--color-navy-800);
  }

  .btn--outline-white {
    background-color: transparent;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.45);
  }

  .btn--outline-white:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: #ffffff;
    color: #ffffff;
  }

  .btn--yellow {
    background-color: var(--color-yellow-500);
    color: var(--color-navy-950);
    border-color: var(--color-yellow-500);
    font-weight: 700;
  }

  .btn--yellow:hover {
    background-color: var(--color-yellow-400);
    border-color: var(--color-yellow-400);
  }
</style>
