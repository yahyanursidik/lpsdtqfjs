---
export interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
  narrow?: boolean;
}

const { as: Tag = 'div', class: className = '', narrow = false } = Astro.props;
---

<Tag class:list={[narrow ? 'container-narrow' : 'container', className]}>
  <slot />
</Tag>
