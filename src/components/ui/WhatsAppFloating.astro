---
import { getWhatsAppUrl } from '../../data/school';

const waUrl = getWhatsAppUrl();
---

<aside class="floating-wa" aria-label="Kontak Cepat WhatsApp">
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-wa__link"
    aria-label="Hubungi Admin PPDB via WhatsApp"
  >
    <svg class="floating-wa__icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.2 3.7.59.25 1.05.4 1.41.51.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
    </svg>
    <span class="floating-wa__text">Tanya PPDB</span>
  </a>
</aside>

<style>
  .floating-wa {
    position: fixed;
    bottom: 1.5rem;
    right: 1.25rem;
    z-index: 900;
  }

  .floating-wa__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-navy-950);
    color: #ffffff;
    padding: 0.75rem 1.15rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 18px rgba(7, 22, 50, 0.28);
    font-size: var(--text-sm);
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .floating-wa__link:hover {
    background-color: var(--color-navy-800);
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(7, 22, 50, 0.35);
  }

  .floating-wa__icon {
    color: var(--color-yellow-400);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .floating-wa__text {
      display: none;
    }

    .floating-wa__link {
      padding: 0.75rem;
      border-radius: 50%;
      width: 46px;
      height: 46px;
      justify-content: center;
    }
  }
</style>
