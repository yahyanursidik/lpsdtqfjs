  <!-- 6. Keunggulan & Program Unggulan -->
  <Highlights />

  <!-- 7. Profil Capaian Lulusan -->
  <GraduateProfile />

  <!-- 8. Aktivitas & Ekstrakurikuler Sunnah -->
