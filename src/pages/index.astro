  <!-- 9. Sarana & Prasarana Fasilitas -->
  <Facilities />

  <!-- 10. Jadwal & Timeline SPMB -->
  <Admissions />

  <!-- 11. Persyaratan Pendaftaran -->
  <Requirements />

  <!-- 12. Rincian Biaya Transparan -->
